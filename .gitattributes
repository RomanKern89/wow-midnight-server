# A patch file with CRLF endings does not apply on Linux — and the container that
# applies this one is Linux. Keep it byte-exact regardless of the checkout host.
*.patch  -text
*.sh     text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.sql    text eol=lf
*.py     text eol=lf
# PowerShell is Windows-only; keep it CRLF so Notepad and the ISE behave.
*.ps1    text eol=crlf
