# Minimal worldserver.conf — rendered from env by entrypoint (envsubst).
# Keys not listed here fall back to TrinityCore built-in defaults.

[worldserver]

LoginDatabaseInfo     = "${DB_HOST};3306;${DB_USER};${DB_PASS};auth"
WorldDatabaseInfo     = "${DB_HOST};3306;${DB_USER};${DB_PASS};world"
CharacterDatabaseInfo = "${DB_HOST};3306;${DB_USER};${DB_PASS};characters"
HotfixDatabaseInfo    = "${DB_HOST};3306;${DB_USER};${DB_PASS};hotfixes"

DataDir         = "/opt/tc/data"
LogsDir         = "/opt/tc/logs"
WorldServerPort = 8085
BindIP          = "0.0.0.0"

# We ship a custom (LoreWalker-based) world DB, so DO NOT let the auto-updater
# touch the world DB. db-init.sh imports base auth/char/hotfix SQL explicitly.
Updates.EnableDatabases = 0

RealmID = 1

# Logging — console only (Docker captures stdout). Silences the default
# "Wrong Loggers configuration" warning.
Appender.Console = 1,3,0
Logger.root = 5,Console
Logger.server = 3,Console

# The companion bots log under "scripts.bots". Without this line they are SILENT:
# TrinityCore's levels run the opposite way to intuition, and root = 5 means
# errors only, so everything the bots report is discarded. A server deployed
# without it looks exactly like a server with no bots in it — which is precisely
# how this was found, on an image where they were running perfectly all along.
Logger.scripts.bots = 3,Console

###############################################################################
# COMPANION BOTS
#
# How many autonomous bots to bring into the world at startup. 0 disables them
# entirely and the server costs nothing extra. See bots/README.md for what they
# do and what a population costs in RAM.
#
# They can also be summoned at any time from the console with
#   .pbot world populate <count>
Pbot.WorldPopulation = 0
